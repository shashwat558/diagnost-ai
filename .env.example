# ── Core infra (docker compose) ────────────────────────────────
POSTGRES_USER=diagnost
POSTGRES_PASSWORD=diagnost_dev_password
POSTGRES_DB=diagnost
DATABASE_URL=postgres://diagnost:diagnost_dev_password@localhost:5432/diagnost

CLICKHOUSE_USER=diagnost
CLICKHOUSE_PASSWORD=diagnost_dev_password
CLICKHOUSE_DB=events
CLICKHOUSE_HTTP_URL=http://localhost:8123

KAFKA_BROKERS=localhost:9092
KAFKA_EVENTS_TOPIC=events.raw

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev_password
S3_BUCKET_TRANSCRIPTS=transcripts
S3_REGION=us-east-1

# ── Apps ───────────────────────────────────────────────────────
API_PORT=4100
DASHBOARD_PORT=3100
NODE_ENV=development

# ── LLM providers (mock-first; set keys to activate real calls) ─
LLM_PROVIDER=mock            # mock | openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

EMBEDDING_PROVIDER=mock      # mock | openai
EMBEDDING_DIM=256
EMBEDDING_MODEL=text-embedding-3-small

# ── GitHub (Phase 4 auto-PR) ───────────────────────────────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# ── Alerting (Phase 3) ─────────────────────────────────────────
SLACK_WEBHOOK_URL=
SMTP_URL=smtp://mailhog:1025

# ── Billing (DodoPayments — full replace of Stripe) ──────────────
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3100/settings?checkout=success
DODO_PAYMENTS_PRODUCT_STARTER=pdt_starter_placeholder
DODO_PAYMENTS_PRODUCT_PRO=pdt_pro_placeholder
