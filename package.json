{
  "name": "diagnost-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Production analytics & self-improvement platform for AI agents",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:nuke": "docker compose down -v",
    "demo": "bash tools/demo/run.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
