# ── Diagnost AI production env (generated by tools/install.sh) ────
# Copy to .env.prod and fill secrets. NEVER commit .env.prod.
# NOTE: app containers talk to infra over the compose network, so URLs use
# service names (postgres/clickhouse/redpanda/minio), NOT localhost.

# ── Public ─────────────────────────────────────────────────────────
DOMAIN=agents.example.com
NEXT_PUBLIC_APP_URL=https://agents.example.com
APP_URL=https://agents.example.com

# ── Postgres ───────────────────────────────────────────────────────
POSTGRES_USER=diagnost
POSTGRES_PASSWORD=CHANGE_ME_32_hex_chars
POSTGRES_DB=diagnost
POSTGRES_PORT=5432
DATABASE_URL=postgres://diagnost:CHANGE_ME_32_hex_chars@postgres:5432/diagnost

# ── ClickHouse ─────────────────────────────────────────────────────
CLICKHOUSE_USER=diagnost
CLICKHOUSE_PASSWORD=CHANGE_ME_32_hex_chars
CLICKHOUSE_DB=events
CLICKHOUSE_HTTP_URL=http://clickhouse:8123

# ── Kafka (Redpanda, in-network listener) ──────────────────────────
KAFKA_BROKERS=redpanda:29092
KAFKA_EVENTS_TOPIC=events.raw

# ── S3 (MinIO, in-network) ─────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME_32_hex_chars
S3_BUCKET_TRANSCRIPTS=transcripts
S3_REGION=us-east-1

# ── Apps ───────────────────────────────────────────────────────────
API_PORT=4100
DASHBOARD_PORT=3100
NODE_ENV=production
SMTP_URL=smtp://user:pass@smtp.resend.com:587
SMTP_FROM=alerts@agents.example.com
DASHBOARD_URL=https://agents.example.com

# ── Billing (DodoPayments, test_mode until live keys) ──────────────
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=https://agents.example.com/settings?checkout=success
DODO_PAYMENTS_PRODUCT_STARTER=pdt_starter_placeholder
DODO_PAYMENTS_PRODUCT_PRO=pdt_pro_placeholder

# ── LLM providers (mock-first; set keys to activate real calls) ────
LLM_PROVIDER=mock
OPENAI_API_KEY=
EMBEDDING_PROVIDER=mock
